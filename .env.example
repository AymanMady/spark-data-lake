# ==========================================================
#  Spark Data Lake - environment variables
#  Copy this file to .env:  cp .env.example .env
#  .env is ignored by git: it may contain secrets.
#  IMPORTANT: no trailing comment on a line (the Docker
#  Compose dotenv parser would include it in the value).
# ==========================================================

# ---------- PostgreSQL (data warehouse) ----------
POSTGRES_USER=dwh_user
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=ecommerce_dwh
# Docker service name: this is the address as seen from the containers
POSTGRES_HOST=postgres
# Port INTERNAL to the docker network
POSTGRES_PORT=5432
# Port exposed on YOUR machine (5432 / 5433 / 5434 are already taken)
POSTGRES_HOST_PORT=5440

# ---------- Spark ----------
# RPC port of the master: spark://spark-master:7077
SPARK_MASTER_HOST_PORT=7077
# Master UI (8080 is already taken on this machine)
SPARK_MASTER_UI_PORT=8090
# Worker UI (8081 is already taken on this machine)
SPARK_WORKER_UI_PORT=8091
# Application (driver) UI, visible while a job runs
SPARK_APP_UI_PORT=4040
# JupyterLab for the exploration notebook
JUPYTER_PORT=8888

# Resources allocated to the worker.
# This machine: 8 vCPU / ~8 GB RAM available -> we keep headroom for the OS
# and for the other containers (postgres, adminer, etc.).
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=4G

# ---------- Ownership of the files written into data/ ----------
# So that the files Spark creates in data/ belong to you on the host.
HOST_UID=1000
HOST_GID=1000
