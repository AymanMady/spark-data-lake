# ---------- Secrets / local config ----------
.env
*.pem
*.key

# ---------- Data lake: NEVER any data in git ----------
data/raw/*
data/bronze/*
data/silver/*
data/gold/*
# Artefacts generated by the jobs: quarantine, quality reports, benchmarks.
# They change on every run and have no place in the history.
data/quarantine/
data/quality/
data/bench/
!data/**/.gitkeep
*.csv
*.parquet
*.json.gz

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
.ruff_cache/

# ---------- Spark ----------
spark-warehouse/
metastore_db/
derby.log
*.crc
_SUCCESS
logs/
spark-events/

# ---------- Tools ----------
.idea/
.vscode/
.DS_Store
benchmarks/results/*.json
ci-quality-reports/
ci-gold/
ci-gold-sql/

